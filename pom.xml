<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sunrisedental</groupId>
    <artifactId>sunrise-dental-clinic</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>Sunrise Dental Clinic Appointment &amp; Patient Management System</name>
    <description>
        CIS6003 Advanced Programming coursework (Cardiff Met, resit).
        3-tier Java Servlet application deployed to Apache Tomcat: presentation
        (servlets) / business (services) / data access (DAO) tiers, backed by
        MySQL. See CLAUDE.md and docs/DESIGN.md at the repository root for the
        full brief and design rationale.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Tomcat 11 implements Jakarta Servlet 6.0 -->
        <jakarta.servlet.version>6.0.0</jakarta.servlet.version>
        <mysql.connector.version>9.3.0</mysql.connector.version>
        <junit.jupiter.version>5.12.2</junit.jupiter.version>
    </properties>

    <dependencies>
        <!-- Servlet API — provided by Tomcat at runtime, not bundled in the WAR -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${jakarta.servlet.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- MySQL JDBC driver (data access tier) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.connector.version}</version>
        </dependency>

        <!-- JSTL (c:if/c:forEach etc. in the JSPs) — Tomcat doesn't bundle
             an implementation itself, so it has to ship in the WAR.
             jakarta.servlet.jsp.jstl-api is listed explicitly, not left
             to come in transitively: the impl artifact below marks its
             own dependency on the API as <scope>provided</scope>, which
             Maven does NOT propagate transitively — omitting this line
             silently drops the JSTL API classes (ConditionalTagSupport
             etc.) from the WAR and every c:if/c:forEach throws
             NoClassDefFoundError at request time despite compiling fine
             (JSPs aren't compiled by Maven, so this only surfaces when
             Tomcat actually renders a page). Found and fixed 2026-09-04
             after exactly that error in a real deployment. -->
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
            <version>3.0.1</version>
        </dependency>

        <!-- JUnit 5 (Task C automated testing) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>sunrise-dental-clinic</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <failOnMissingWebXml>true</failOnMissingWebXml>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
