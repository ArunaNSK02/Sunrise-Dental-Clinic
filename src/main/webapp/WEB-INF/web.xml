<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Sunrise Dental Clinic</display-name>

    <!--
        Servlets in this project are registered with @WebServlet annotations
        (Jakarta Servlet 6.0 / Tomcat 11 supports annotation-based routing —
        see CLAUDE.md's "Confirmed local development environment" section).
        This file stays deliberately minimal: welcome file and session
        config only. Servlet <servlet-mapping> entries are NOT duplicated
        here.
    -->

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <session-config>
        <!-- Login state is tracked via HttpSession per CLAUDE.md's session
             requirement; 30 minutes matches a realistic front-desk shift
             gap without leaving stale sessions open indefinitely. -->
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

</web-app>
